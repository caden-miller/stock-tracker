# Copy this file to .env and fill in the values.
# .env is gitignored — never commit real secrets.

# PostgreSQL connection
DATABASE_USER=caden
DATABASE_PASSWORD=
DATABASE_PORT=5433

# Truthifi MCP — financial data aggregation (BofA, Empower, Fidelity, Capital One, 18k+ institutions)
# Connect at /truthifi/connect after signing up at truthifi.com — no manual token needed.
# The redirect URI must match what you register with Truthifi. Change port if needed.
TRUTHIFI_REDIRECT_URI=http://localhost:3000/truthifi/callback

# Active Record encryption for TruthifiConnection tokens at rest.
# Generate with: rails runner 'puts ActiveRecord::Encryption::KeyGenerator.new.generate_random_hex_key(length: 32)'
AR_ENCRYPTION_PRIMARY_KEY=
AR_ENCRYPTION_DETERMINISTIC_KEY=
AR_ENCRYPTION_KEY_DERIVATION_SALT=
