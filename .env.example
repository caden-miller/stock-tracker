# Copy this file to .env and fill in the values.
# .env is gitignored — never commit real secrets.

# Phase 2 — SnapTrade (brokerage aggregation)
# https://snaptrade.com/developers
SNAPTRADE_CLIENT_ID=
SNAPTRADE_CONSUMER_KEY=

# Phase 3 — Plaid (banking aggregation)
# https://dashboard.plaid.com/signup
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox   # sandbox | development | production

# Active Record encryption (PlaidItem#plaid_access_token at rest)
# Generate with: bin/rails db:encryption:init
AR_ENCRYPTION_PRIMARY_KEY=
AR_ENCRYPTION_DETERMINISTIC_KEY=
AR_ENCRYPTION_KEY_DERIVATION_SALT=
