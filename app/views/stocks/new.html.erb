<h1>Add Stock</h1>
<div class="card">
  <%= form_with(model: @stock) do |form| %>
    <% if @stock.errors.any? %>
      <div class="flash flash-danger">
        <ul>
          <% @stock.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>
    <div class="field">
      <%= form.label :symbol %>
      <%= form.text_field :symbol, placeholder: "e.g. AAPL" %>
    </div>
    <div class="field">
      <%= form.label :name %>
      <%= form.text_field :name, placeholder: "e.g. Apple Inc." %>
    </div>
    <%= form.submit "Add Stock" %>
  <% end %>
</div>
