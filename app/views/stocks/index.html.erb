<h1>Stocks</h1>
<table>
  <tr>
    <th>Symbol</th>
    <th>Name</th>
    <th></th>
  </tr>
  <% @stocks.each do |stock| %>
    <tr>
      <td><%= stock.symbol %></td>
      <td><%= stock.name %></td>
      <td>
        <%= link_to "Edit", edit_stock_path(stock) %> |
        <%= link_to "Remove", stock_path(stock), data: { turbo_method: :delete, turbo_confirm: "Remove #{stock.symbol}?" } %>
      </td>
    </tr>
  <% end %>
</table>
<%= link_to "Add Stock", new_stock_path %>
