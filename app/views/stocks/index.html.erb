<h1>Stocks</h1>
<table>
  <tr>
    <th>Symbol</th>
    <th>Name</th>
    <th></th>
  </tr>
  <% @stocks.each do |stock| %>
    <tr>
      <td><%= stock.symbol %></td>
      <td><%= stock.name %></td>
      <td class="actions">
        <%= button_link "Edit", edit_stock_path(stock), style: :secondary %>
        <%= delete_link "Remove", stock_path(stock), confirm: "Remove #{stock.symbol}?" %>
      </td>
    </tr>
  <% end %>
</table>
<p><%= button_link "Add Stock", new_stock_path %></p>
