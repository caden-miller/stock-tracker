<h1>Edit Stock</h1>
<div class="card">
  <%= form_with(model: @stock) do |form| %>
    <% if @stock.errors.any? %>
      <div class="flash flash-danger">
        <ul>
          <% @stock.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>
    <div class="field">
      <%= form.label :symbol %>
      <%= form.text_field :symbol %>
    </div>
    <div class="field">
      <%= form.label :name %>
      <%= form.text_field :name %>
    </div>
    <%= form.submit "Update Stock" %>
  <% end %>
</div>
<p><%= link_to "Back", stocks_path %></p>
