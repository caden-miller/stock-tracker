<h1>Edit Balance</h1>
<%= form_with(model: @balance) do |form| %>
  <div>
    <%= form.label :amount %><br>
    <%= form.number_field :amount, step: 0.01 %>
  </div>
  <div>
    <%= form.label :date %><br>
    <%= form.datetime_select :date %>
  </div>
  <%= form.submit "Update Balance" %>
<% end %>
<%= link_to "Back", balances_path %>
