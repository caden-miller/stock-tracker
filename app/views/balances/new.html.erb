<h1>New Balance</h1>
<div class="card">
  <%= form_with(model: @balance) do |form| %>
    <div class="field">
      <%= form.label :amount %>
      <%= form.number_field :amount, step: 0.01 %>
    </div>
    <div class="field">
      <%= form.label :date %>
      <%= form.datetime_select :date %>
    </div>
    <%= form.submit "Create Balance" %>
  <% end %>
</div>
<p><%= link_to "Back", balances_path %></p>
