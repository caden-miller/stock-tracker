<h1>Edit Stock Holding</h1>
<div class="card">
  <%= form_with(model: @holding) do |form| %>
    <div class="field">
      <%= form.label :stock_id, "Stock" %>
      <%= form.collection_select :stock_id, @stocks, :id, :name %>
    </div>
    <div class="field">
      <%= form.label :quantity %>
      <%= form.number_field :quantity, step: 0.01 %>
    </div>
    <div class="field">
      <%= form.label :purchase_price %>
      <%= form.number_field :purchase_price, step: 0.01 %>
    </div>
    <div class="field">
      <%= form.label :purchase_date %>
      <%= form.datetime_select :purchase_date %>
    </div>
    <%= form.submit "Update Holding" %>
  <% end %>
</div>
<p><%= link_to "Back", stock_holdings_path %></p>
