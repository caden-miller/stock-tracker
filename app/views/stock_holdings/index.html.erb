<h1>Stock Holdings</h1>
<table>
  <tr>
    <th>Stock</th>
    <th>Quantity</th>
    <th>Purchase Price</th>
    <th>Purchase Date</th>
    <th>Current Price</th>
    <th>Current Value</th>
    <th></th>
  </tr>
  <% @stock_holdings.each do |holding| %>
    <tr>
      <td><%= holding.stock.name %> (<%= holding.stock.symbol %>)</td>
      <td><%= holding.quantity %></td>
      <td><%= number_to_currency(holding.purchase_price) %></td>
      <td><%= holding.purchase_date.strftime('%Y-%m-%d') %></td>
      <td><%= holding.current_price ? number_to_currency(holding.current_price) : "N/A" %></td>
      <td><%= holding.current_value ? number_to_currency(holding.current_value) : "N/A" %></td>
      <td>
        <%= link_to "Edit", edit_stock_holding_path(holding) %> |
        <%= link_to "Remove", stock_holding_path(holding), data: { turbo_method: :delete, turbo_confirm: "Remove this holding?" } %>
      </td>
    </tr>
  <% end %>
</table>
<p>Total Current Value: <%= number_to_currency(@total_current_value) %></p>
<%= link_to "Add Stock Purchase", new_stock_holding_path %>
