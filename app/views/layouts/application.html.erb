<!DOCTYPE html>
<html>
  <head>
    <title>StockTracker</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <nav class="navbar">
      <%= link_to "Balances", balances_path %>
      <%= link_to "Holdings", stock_holdings_path %>
      <%= link_to "Stocks", stocks_path %>
      <%= link_to "Link Brokerage", brokerage_connect_path %>
      <%= link_to "Link Bank", banking_connect_path %>
    </nav>

    <main class="container">
      <%= render "shared/flash" %>
      <%= yield %>
    </main>
  </body>
</html>
